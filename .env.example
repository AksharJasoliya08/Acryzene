# ============================================
# KATARGAM STORE - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# NEVER expose secrets to frontend JavaScript

# --------------------------------------------
# APPLICATION
# --------------------------------------------
APP_ENV=development
APP_URL=http://localhost:5173
DEMO_MODE=true

# --------------------------------------------
# SOURCE STORE (Product Import)
# --------------------------------------------
# The external website to import products from
# IMPORTANT: This is scraped server-side, never from browser
SOURCE_STORE_URL=https://katargam.szbilling.com/
SOURCE_SYNC_ENABLED=true
SOURCE_SYNC_INTERVAL=60

# --------------------------------------------
# PRICING CONFIGURATION
# --------------------------------------------
# Markup type: fixed | percentage | manual | per_product
DEFAULT_MARKUP_TYPE=fixed
# For fixed: amount in currency (e.g., 5 = +₹5)
# For percentage: percentage value (e.g., 10 = +10%)
DEFAULT_MARKUP_VALUE=5
# Price rounding: none | nearest_1 | nearest_5 | nearest_10 | ending_99
PRICE_ROUNDING=nearest_5

# --------------------------------------------
# RAZORPAY PAYMENT
# --------------------------------------------
# Public key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Secret key (NEVER expose to frontend - server-side only)
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --------------------------------------------
# CASH ON DELIVERY
# --------------------------------------------
ENABLE_COD=true
COD_FEE=20
COD_MIN_ORDER=200
COD_MAX_ORDER=50000

# --------------------------------------------
# DATABASE (Backend)
# --------------------------------------------
DATABASE_URL=mysql://user:password@localhost:3306/katargam_store
# NEVER expose DATABASE_PASSWORD to frontend

# --------------------------------------------
# EMAIL / SMTP
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@katargam.com
SMTP_PASSWORD=your_smtp_password
SMTP_ENCRYPTION=tls
# NEVER expose SMTP_PASSWORD to frontend

# --------------------------------------------
# SHIPPING
# --------------------------------------------
DEFAULT_SHIPPING_CHARGE=60
FREE_SHIPPING_THRESHOLD=999

# --------------------------------------------
# TAX / GST
# --------------------------------------------
DEFAULT_GST_PERCENT=18
STORE_GSTIN=24AABCU9603R1ZM

# --------------------------------------------
# ANALYTICS (Optional)
# --------------------------------------------
VITE_GA_TRACKING_ID=

# --------------------------------------------
# FEATURES
# --------------------------------------------
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_RECENTLY_VIEWED=true
VITE_ENABLE_NEWSLETTER=true

# --------------------------------------------
# SECURITY
# --------------------------------------------
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here
# NEVER expose these to frontend

# --------------------------------------------
# SMS / WHATSAPP (Optional)
# --------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# --------------------------------------------
# FILE UPLOADS
# --------------------------------------------
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
